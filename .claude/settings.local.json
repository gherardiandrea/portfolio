{
  "permissions": {
    "allow": [
      "Bash(command -v nvm)",
      "Bash(nvm --version)",
      "Bash(curl -s https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh)",
      "Bash(bash)",
      "Bash(export NVM_DIR=\"$HOME/.nvm\")",
      "Bash(. \"$NVM_DIR/nvm.sh\")",
      "Bash(nvm use:*)",
      "Bash(npm install:*)",
      "Bash(npx astro:*)"
    ]
  }
}
