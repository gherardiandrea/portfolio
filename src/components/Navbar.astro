---
const links = [
  { href: '#experience', label: 'Esperienza' },
  { href: '#projects',   label: 'Progetti' },
  { href: '#stack',      label: 'Stack' },
  { href: '#contact',    label: 'Contatti' },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="font-mono text-sm font-medium tracking-widest gradient-text hover:opacity-80 transition-opacity">
      AG
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-link text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors duration-200 relative"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 group"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-5 h-px bg-[var(--color-text-secondary)] transition-all duration-300 group-[.open]:rotate-45 group-[.open]:translate-y-2"></span>
      <span class="block w-5 h-px bg-[var(--color-text-secondary)] transition-all duration-300 group-[.open]:opacity-0"></span>
      <span class="block w-5 h-px bg-[var(--color-text-secondary)] transition-all duration-300 group-[.open]:-rotate-45 group-[.open]:-translate-y-2"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute inset-x-0 top-full bg-[var(--color-bg)]/95 backdrop-blur-xl border-b border-[var(--color-border)] px-6 py-6"
  >
    <ul class="flex flex-col gap-4">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="mobile-link block text-lg font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  // Scroll background
  const navbar = document.getElementById('navbar')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar.style.cssText = 'background: rgba(8,8,16,0.85); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(34,34,58,0.8);';
    } else {
      navbar.style.cssText = '';
    }
  }, { passive: true });

  // Mobile menu
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });

  // Close mobile menu on link click
  menu.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });
  });

  // Active section highlight
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(link => {
            const active = link.getAttribute('href') === `#${entry.target.id}`;
            link.classList.toggle('!text-[var(--color-text-primary)]', active);
          });
        }
      });
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );
  sections.forEach(s => observer.observe(s));
</script>
