---
const links = [
  { href: '#experience', label: 'Esperienza', num: '01' },
  { href: '#projects',   label: 'Progetti',   num: '02' },
  { href: '#stack',      label: 'Stack',       num: '03' },
  { href: '#contact',    label: 'Contatti',    num: '04' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  style="padding: 1.5rem 2.5rem;"
>
  <nav
    style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between;"
  >
    <!-- Logotype -->
    <a
      href="#"
      class="underline-hover"
      style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 300; letter-spacing: 0.15em; color: var(--color-ink); text-decoration: none;"
      aria-label="Torna all'inizio"
    >
      A.G.
    </a>

    <!-- Desktop navigation -->
    <ul
      id="nav-links"
      style="display: flex; align-items: center; gap: 2.5rem; list-style: none; margin: 0; padding: 0;"
    >
      {links.map(({ href, label, num }) => (
        <li>
          <a
            href={href}
            data-section={href.slice(1)}
            class="nav-link"
            style="font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-ink-ghost); text-decoration: none; transition: color 0.25s ease; display: flex; align-items: center; gap: 0.4rem;"
          >
            <span style="color: var(--color-terra); font-size: 0.7rem;">{num}</span>
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile burger -->
    <button
      id="burger"
      aria-label="Menu"
      aria-expanded="false"
      style="display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px;"
    >
      <span id="b1" style="display: block; width: 22px; height: 1px; background: var(--color-ink-dim); transition: all 0.3s ease;"></span>
      <span id="b2" style="display: block; width: 22px; height: 1px; background: var(--color-ink-dim); transition: all 0.3s ease;"></span>
      <span id="b3" style="display: block; width: 14px; height: 1px; background: var(--color-terra); transition: all 0.3s ease;"></span>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div
    id="mobile-drawer"
    style="display: none; position: fixed; inset: 0; background: var(--color-bg); z-index: 100; flex-direction: column; justify-content: center; align-items: flex-start; padding: 3rem 2.5rem; gap: 2rem;"
  >
    <button
      id="close-menu"
      aria-label="Chiudi menu"
      style="position: absolute; top: 1.5rem; right: 2.5rem; background: none; border: none; cursor: pointer; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em; color: var(--color-ink-ghost); text-transform: uppercase;"
    >
      Chiudi ×
    </button>
    {links.map(({ href, label, num }) => (
      <a
        href={href}
        class="mobile-link"
        style="font-family: var(--font-display); font-size: 3rem; font-weight: 300; color: var(--color-ink-dim); text-decoration: none; transition: color 0.2s; display: flex; align-items: baseline; gap: 1rem; line-height: 1;"
      >
        <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-terra); letter-spacing: 0.15em;">{num}</span>
        {label}
      </a>
    ))}
  </div>
</header>

<style>
  @media (max-width: 640px) {
    #nav-links { display: none !important; }
    #burger { display: flex !important; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar')!;
  const burger = document.getElementById('burger')!;
  const drawer = document.getElementById('mobile-drawer')!;
  const closeBtn = document.getElementById('close-menu')!;
  const b1 = document.getElementById('b1')!;
  const b2 = document.getElementById('b2')!;
  const b3 = document.getElementById('b3')!;

  // Scroll: add background
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      navbar.style.background = 'rgba(10,9,7,0.92)';
      navbar.style.backdropFilter = 'blur(12px)';
      navbar.style.borderBottom = '1px solid rgba(39,37,32,0.8)';
    } else {
      navbar.style.background = '';
      navbar.style.backdropFilter = '';
      navbar.style.borderBottom = '';
    }
  }, { passive: true });

  // Mobile toggle
  function openMenu() {
    drawer.style.display = 'flex';
    burger.setAttribute('aria-expanded', 'true');
    b1.style.transform = 'rotate(45deg) translate(4px, 4px)';
    b2.style.opacity = '0';
    b3.style.transform = 'rotate(-45deg) translate(4px, -4px)';
    b3.style.width = '22px';
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    drawer.style.display = 'none';
    burger.setAttribute('aria-expanded', 'false');
    b1.style.transform = '';
    b2.style.opacity = '';
    b3.style.transform = '';
    b3.style.width = '14px';
    document.body.style.overflow = '';
  }

  burger.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  document.querySelectorAll('.mobile-link').forEach(l => l.addEventListener('click', closeMenu));

  // Active section
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = document.querySelectorAll<HTMLElement>('section[id]');

  const obs = new IntersectionObserver(
    entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        navLinks.forEach(link => {
          const active = link.dataset.section === e.target.id;
          link.style.color = active ? 'var(--color-ink)' : 'var(--color-ink-ghost)';
        });
      });
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );
  sections.forEach(s => obs.observe(s));
</script>
