---
const categories = [
  {
    num: '—',
    label: 'Backend',
    items: [
      { name: 'PHP',       note: '10 anni' },
      { name: 'Laravel',   note: 'framework principale' },
      { name: 'Symfony',   note: 'framework' },
      { name: 'MySQL',     note: 'database relazionale' },
      { name: 'Redis',     note: 'cache & queue' },
      { name: 'REST API',  note: 'design & consumo' },
      { name: 'OAuth2',    note: 'autenticazione API' },
    ],
  },
  {
    num: '—',
    label: 'Frontend',
    items: [
      { name: 'HTML / CSS',    note: 'semantico, accessibile' },
      { name: 'JavaScript',    note: 'vanilla & moderno' },
      { name: 'TypeScript',    note: 'tipizzazione' },
      { name: 'Vue.js',        note: 'componenti reattivi' },
      { name: 'Tailwind CSS',  note: 'utility-first' },
      { name: 'Alpine.js',     note: 'interattività leggera' },
    ],
  },
  {
    num: '—',
    label: 'Tools',
    items: [
      { name: 'Git',            note: 'versioning' },
      { name: 'Linux',          note: 'server & dev' },
      { name: 'Docker',         note: 'container' },
      { name: 'Nginx',          note: 'web server' },
      { name: 'CI / CD',        note: 'deploy automatizzato' },
      { name: 'PHPUnit / Pest', note: 'testing' },
      { name: 'AWS S3',         note: 'storage' },
    ],
  },
];
---

<section
  id="stack"
  style="padding: 7rem 2.5rem; max-width: 1200px; margin: 0 auto;"
>
  <!-- Section header -->
  <div class="reveal" style="display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 4rem;">
    <span class="section-label">03 — Stack</span>
    <div style="flex: 1; height: 1px; background: var(--color-border);"></div>
  </div>

  <!-- Three columns -->
  <div
    style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem;"
  >
    {categories.map(cat => (
      <div class="reveal">
        <!-- Category title -->
        <h3
          style="font-family: var(--font-display); font-weight: 300; font-size: 1.6rem; font-style: italic; color: var(--color-ink); margin: 0 0 1.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border);"
        >{cat.label}</h3>

        <!-- Items list -->
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0;">
          {cat.items.map((item, idx) => (
            <li
              style={`
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                padding: 0.7rem 0;
                border-bottom: 1px solid var(--color-border);
                gap: 1rem;
                ${idx === 0 ? 'border-top: 1px solid var(--color-border);' : ''}
              `}
            >
              <span
                style="font-family: var(--font-body); font-weight: 400; font-size: 0.9rem; color: var(--color-ink);"
              >{item.name}</span>
              <span
                style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: var(--color-ink-ghost); text-align: right; flex-shrink: 0;"
              >{item.note}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

</section>

<style>
  @media (max-width: 900px) {
    div[style*="grid-template-columns: repeat(3, 1fr); gap: 3rem"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 640px) {
    section { padding: 5rem 1.5rem !important; }
    div[style*="grid-template-columns: repeat(3, 1fr); gap: 3rem"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
