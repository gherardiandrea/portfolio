---
---

<section
  id="hero"
  style="position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 2.5rem 4rem; overflow: hidden;"
>

  <!-- Decorative background number -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      top: 50%;
      right: -2rem;
      transform: translateY(-50%);
      font-family: var(--font-display);
      font-size: clamp(18rem, 30vw, 28rem);
      font-weight: 300;
      font-style: italic;
      color: transparent;
      -webkit-text-stroke: 1px rgba(196,98,45,0.06);
      line-height: 1;
      pointer-events: none;
      user-select: none;
      letter-spacing: -0.05em;
    "
  >AG</div>

  <!-- Horizontal rule at top -->
  <div
    style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--color-border);"
    aria-hidden="true"
  ></div>

  <!-- Vertical rule right -->
  <div
    style="position: absolute; top: 0; right: 2.5rem; bottom: 0; width: 1px; background: var(--color-border); opacity: 0.5;"
    aria-hidden="true"
  ></div>

  <!-- Content max width -->
  <div style="max-width: 1200px; margin: 0 auto; width: 100%; position: relative; z-index: 1;">

    <!-- Status badge -->
    <div
      style="display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: 3rem; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ink-ghost);"
    >
      <span
        style="width: 6px; height: 6px; border-radius: 50%; background: #4ade80; display: inline-block;"
      ></span>
      Disponibile per collaborazioni
    </div>

    <!-- Main name — huge, editorial serif -->
    <h1
      style="
        font-family: var(--font-display);
        font-weight: 300;
        font-style: italic;
        font-size: clamp(4rem, 12vw, 10rem);
        line-height: 0.9;
        letter-spacing: -0.02em;
        color: var(--color-ink);
        margin: 0 0 0.15em;
      "
    >
      Andrea<br />
      <span style="color: var(--color-terra); font-style: normal; font-weight: 600;">Gherardi</span>
    </h1>

    <!-- Divider -->
    <div style="height: 1px; background: var(--color-border-warm); margin: 2rem 0; max-width: 480px;"></div>

    <!-- Bottom row: role + stats -->
    <div
      style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem;"
    >
      <div>
        <p
          style="font-family: var(--font-body); font-weight: 300; font-size: clamp(0.9rem, 2vw, 1.1rem); color: var(--color-ink-dim); letter-spacing: 0.05em; margin: 0 0 1.5rem;"
        >
          Web Developer — PHP · Laravel · Symfony
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="#projects" class="btn-terra" style="text-decoration: none;">
            Vedi i progetti
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#contact" class="btn-ghost" style="text-decoration: none;">
            Contattami
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div
        style="display: flex; gap: 2.5rem; flex-wrap: wrap;"
      >
        {[
          { n: '10+', l: 'anni di\ncoding' },
          { n: '2019', l: 'laurea\ndalmine (bg)' },
          { n: '2016', l: 'primo\nprogetto web' },
        ].map(s => (
          <div style="text-align: right;">
            <div
              style="font-family: var(--font-display); font-weight: 600; font-size: 2rem; color: var(--color-ink); line-height: 1;"
            >{s.n}</div>
            <div
              style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-ghost); margin-top: 0.25rem; white-space: pre-line; text-align: right;"
            >{s.l}</div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- Scroll hint -->
  <div
    aria-hidden="true"
    style="position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.5rem;"
  >
    <span style="font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-ink-ghost);">scroll</span>
    <div style="width: 1px; height: 48px; background: linear-gradient(to bottom, var(--color-terra), transparent);"></div>
  </div>

</section>

<style>
  @media (max-width: 640px) {
    #hero { padding: 0 1.5rem 5rem; }
  }
</style>
