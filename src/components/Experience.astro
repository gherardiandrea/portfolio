---
const experiences = [
  {
    period: '2022 — presente',
    role: 'Senior Web Developer',
    company: 'freedome.it / freedome.eu',
    location: 'Remote',
    description:
      'Sviluppo e manutenzione di due marketplace per esperienze outdoor. Architetture Laravel con team distribuito, integrazione pagamenti, API esterne e ottimizzazione delle performance.',
    tags: ['PHP', 'Laravel', 'MySQL', 'Redis', 'REST API'],
    current: true,
  },
  {
    period: '2019 — 2022',
    role: 'Full-stack Web Developer',
    company: 'freedome.it',
    location: 'Italia',
    description:
      'Entrato a tempo pieno dopo la laurea. Costruzione delle fondamenta del prodotto: sistema di prenotazioni, pannello operatori, sistema di pagamento e CMS custom.',
    tags: ['PHP', 'Laravel', 'Vue.js', 'MySQL'],
    current: false,
  },
  {
    period: '2019',
    role: 'Laurea in Ingegneria Informatica',
    company: 'Università degli Studi di Bergamo',
    location: 'Dalmine (BG)',
    description:
      'Percorso triennale in ingegneria informatica presso il campus di Dalmine. Tesi incentrata sullo sviluppo web.',
    tags: ['Informatica', 'Algoritmi', 'Reti', 'Tesi'],
    current: false,
    isEducation: true,
  },
  {
    period: '2016 — 2019',
    role: 'Web Developer (part-time)',
    company: 'Freelance & prime esperienze',
    location: 'Italia',
    description:
      'Prime esperienze di sviluppo web in parallelo agli studi. Progetti freelance, siti e web app in PHP, WordPress e primi approcci a Laravel.',
    tags: ['PHP', 'WordPress', 'jQuery', 'MySQL'],
    current: false,
  },
];
---

<section id="experience" class="section px-6">
  <div class="max-w-3xl mx-auto">

    <div class="reveal">
      <h2 class="section-title">Esperienza</h2>
      <p class="section-subtitle">Il percorso che mi ha portato qui.</p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div
        class="absolute left-4 top-2 bottom-2 w-px"
        style="background: linear-gradient(to bottom, var(--color-accent), var(--color-accent-bright), transparent);"
        aria-hidden="true"
      ></div>

      <div class="flex flex-col gap-10 pl-14">
        {experiences.map((exp, i) => (
          <div class={`reveal relative group`}>

            <!-- Dot on timeline -->
            <div
              class={`absolute -left-[2.875rem] top-1.5 w-3.5 h-3.5 rounded-full border-2 transition-all duration-300 group-hover:scale-125 ${
                exp.current
                  ? 'border-[var(--color-accent-bright)] bg-[var(--color-accent-bright)] shadow-[0_0_12px_rgba(6,182,212,0.6)]'
                  : exp.isEducation
                    ? 'border-violet-400 bg-transparent'
                    : 'border-[var(--color-border-bright)] bg-[var(--color-bg)]'
              }`}
              aria-hidden="true"
            ></div>

            <!-- Card -->
            <div class="gradient-border p-5 transition-all duration-300 hover:bg-[var(--color-bg-card-hover)]">

              <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                <div>
                  <h3 class="font-heading font-semibold text-[var(--color-text-primary)] text-base">
                    {exp.role}
                  </h3>
                  <p class="text-sm text-[var(--color-text-secondary)] mt-0.5">
                    {exp.company}
                    <span class="text-[var(--color-text-muted)] mx-1">·</span>
                    {exp.location}
                  </p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  {exp.current && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-mono border border-emerald-500/30 text-emerald-400 bg-emerald-500/10">
                      attuale
                    </span>
                  )}
                  <span class="font-mono text-xs text-[var(--color-text-muted)]">
                    {exp.period}
                  </span>
                </div>
              </div>

              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
                {exp.description}
              </p>

              <div class="flex flex-wrap gap-2">
                {exp.tags.map(tag => (
                  <span class="font-mono text-xs px-2.5 py-1 rounded-md border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)]">
                    {tag}
                  </span>
                ))}
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
