---
const experiences = [
  {
    period: '2023 — presente',
    role: 'Senior Web Developer',
    company: 'freedome.it / freedome.eu',
    location: 'Remote · Italia',
    description: 'Sviluppo e manutenzione di due marketplace per esperienze outdoor. Architettura Laravel in team distribuito, integrazione gateway di pagamento, API esterne, Redis caching e ottimizzazione performance.',
    tags: ['PHP', 'Laravel', 'MySQL', 'Redis', 'Stripe API'],
    current: true,
    url: 'https://www.freedome.it',
  },
  {
    period: '2021 — 2023',
    role: 'Web Developer',
    company: 'LSWR Group',
    location: 'Italia',
    description: 'Sviluppo web in ambito editoriale e formativo. Realizzazione e manutenzione di piattaforme digitali per uno dei principali gruppi editoriali italiani specializzati in contenuti professionali.',
    tags: ['PHP', 'Laravel', 'MySQL', 'REST API'],
    current: false,
    url: 'http://www.lswrgroup.com/',
  },
  {
    period: '2019 — 2021',
    role: 'Web Developer',
    company: 'DDX Group',
    location: 'Italia',
    description: 'Sviluppo di soluzioni web e applicativi per clienti enterprise. Primo impiego full-time dopo la laurea, con focus su PHP, Laravel e integrazione di sistemi.',
    tags: ['PHP', 'Laravel', 'Symfony', 'MySQL'],
    current: false,
    url: 'https://www.ddxgroup.com/',
  },
  {
    period: '2019',
    role: 'Laurea — Ingegneria Informatica',
    company: 'Università degli Studi di Bergamo',
    location: 'Campus di Dalmine (BG)',
    description: 'Percorso triennale in ingegneria informatica. Formazione su algoritmi, reti, architetture software e sviluppo applicativo.',
    tags: ['Informatica', 'Algoritmi', 'Reti', 'Architetture'],
    current: false,
    isEdu: true,
  },
  {
    period: '2016 — 2019',
    role: 'Web Developer (part-time)',
    company: 'DDX Group',
    location: 'Italia',
    description: 'Prime esperienze lavorative in parallelo agli studi universitari. Sviluppo web con PHP e i primi approcci a Laravel, crescendo gradualmente nelle responsabilità fino all\'impiego full-time dopo la laurea.',
    tags: ['PHP', 'Laravel', 'MySQL', 'jQuery'],
    current: false,
    url: 'https://www.ddxgroup.com/',
  },
];
---

<section
  id="experience"
  style="padding: 7rem 2.5rem; max-width: 1200px; margin: 0 auto;"
>
  <!-- Section header -->
  <div class="reveal" style="display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 4rem;">
    <span class="section-label">01 — Esperienza</span>
    <div style="flex: 1; height: 1px; background: var(--color-border);"></div>
  </div>

  <!-- Timeline -->
  <div style="display: flex; flex-direction: column; gap: 0; position: relative; padding-left: 2rem;">

    <!-- Vertical line -->
    <div
      style="position: absolute; left: 0; top: 0.5rem; bottom: 0; width: 1px; background: linear-gradient(to bottom, var(--color-terra), var(--color-border), transparent);"
      aria-hidden="true"
    ></div>

    {experiences.map((exp) => (
      <div
        class="reveal"
        style="position: relative; padding-bottom: 3.5rem;"
      >
        <!-- Dot -->
        <div
          style={`
            position: absolute;
            left: -2rem;
            top: 0.6rem;
            transform: translateX(-50%);
            width: ${exp.current ? '10px' : '6px'};
            height: ${exp.current ? '10px' : '6px'};
            border-radius: 50%;
            background: ${exp.current ? 'var(--color-terra)' : exp.isEdu ? 'transparent' : 'var(--color-border-warm)'};
            border: ${exp.isEdu ? '1px solid var(--color-terra)' : 'none'};
            ${exp.current ? 'box-shadow: 0 0 0 3px rgba(196,98,45,0.2);' : ''}
          `}
          aria-hidden="true"
        ></div>

        <!-- Card content -->
        <div
          class="card"
          style="padding: 1.75rem 2rem; position: relative; overflow: hidden;"
        >
          <!-- Terra accent left border -->
          {exp.current && (
            <div
              style="position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--color-terra);"
              aria-hidden="true"
            ></div>
          )}

          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem;">
            <div>
              <h3
                style="font-family: var(--font-display); font-weight: 400; font-size: 1.4rem; color: var(--color-ink); margin: 0 0 0.2rem;"
              >{exp.role}</h3>
              <p
                style="font-family: var(--font-body); font-weight: 300; font-size: 0.85rem; color: var(--color-ink-dim); margin: 0;"
              >
                {exp.url ? (
                  <a
                    href={exp.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="color: var(--color-ink-dim); text-decoration: none; border-bottom: 1px solid rgba(240,236,216,0.15); transition: border-color 0.2s, color 0.2s;"
                    onmouseenter="this.style.color='var(--color-ink)';this.style.borderColor='var(--color-terra)'"
                    onmouseleave="this.style.color='var(--color-ink-dim)';this.style.borderColor='rgba(240,236,216,0.15)'"
                  >{exp.company}</a>
                ) : exp.company}
                <span style="color: var(--color-terra); margin: 0 0.4rem;">·</span>
                {exp.location}
              </p>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0;">
              {exp.current && (
                <span
                  style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: #4ade80; border: 1px solid rgba(74,222,128,0.25); padding: 0.2rem 0.6rem; background: rgba(74,222,128,0.05);"
                >live</span>
              )}
              <span
                style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--color-ink-ghost);"
              >{exp.period}</span>
            </div>
          </div>

          <p
            style="font-family: var(--font-body); font-weight: 300; font-size: 0.9rem; line-height: 1.7; color: var(--color-ink-dim); margin: 0 0 1.25rem;"
          >{exp.description}</p>

          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {exp.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  @media (max-width: 640px) {
    section { padding: 5rem 1.5rem !important; }
  }
</style>
